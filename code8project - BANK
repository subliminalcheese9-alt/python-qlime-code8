balance = 1000
username = 'admin'
password = '1234'
tries = 0
while True:
    if tries > 2:
        print('Sorry, You Ran Out Of Attempts. Locked Out!')
        break
    userUsernameInput = input('Welcome To PythonBank! Please, Log In. Whats Your Username?').strip()
    userPasswordInput = input(f"{userUsernameInput}, Please Enter Your Password.").strip()
    if userUsernameInput == username and userPasswordInput == password:
        print('Successfully Logged In!')
        break
    else:
        print('Sorry, You May Have Entered Something Wrong. Please, Try Again.')
        tries = tries + 1
def showMenu():
    choice = input(f"Bank Menu / Options: 1. Check Balance, 2. Deposit Money, 3. Withdraw Money, 4. Exit, Type An Option You Want To Choose.").strip().lower()
    return choice
while True:
    choice = showMenu()
    if choice == 'check balance':
        print(balance)
    elif choice == 'deposit money':
        try:
            amountDeposited = int(input('How Much Money Would You Like To Deposit?'))
            balance = balance + amountDeposited
        except ValueError:
            print('Sorry, You May Have Entered Something Wrong. Please, Try Again. ValueError')
    elif choice == 'withdraw money':
        try:
            amountWithdrawed = int(input('How Much Money Would You Like To Withdraw?'))
            balance = balance - amountWithdrawed
        except ValueError:
            print('Sorry, You May Have Entered Something Wrong. Please, Try Again. ValueError')
    elif choice == 'exit':
        print('Goodbye!')
        break

